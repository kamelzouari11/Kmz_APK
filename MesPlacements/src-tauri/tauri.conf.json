{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mes Placements",
  "version": "0.1.0",
  "identifier": "tn.kmzapk.mesplacements",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mes Placements",
        "width": 1200,
        "height": 860,
        "minWidth": 760,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Suivi des revenus de placements financiers",
    "longDescription": "Une application simple et locale pour preparer le suivi fiscal de vos placements.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
