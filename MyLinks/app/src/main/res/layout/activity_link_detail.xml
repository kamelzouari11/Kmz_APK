<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit link"
            android:textColor="@color/app_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Open publication" />

            <Button
                android:id="@+id/openProfileButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Open advertiser profile" />
        </LinearLayout>

        <ImageView android:id="@+id/profileImage" android:layout_width="192dp" android:layout_height="192dp" android:scaleType="centerCrop" android:layout_marginTop="16dp" android:contentDescription="Advertiser profile image" android:visibility="gone" />
        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/app_text_muted" />
        <TextView
            android:id="@+id/dateStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/app_text_muted" />
        <Button
            android:id="@+id/recheckAiButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recheck this link with AI" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Title"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/titleField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Category"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/categoryField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />


                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Tags" android:textStyle="bold" android:textColor="@color/app_text" />
                <EditText style="@style/Widget.MyLinks.Input" android:id="@+id/tagsField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:inputType="textUri" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Profile URL" android:textStyle="bold" android:textColor="@color/app_text" />
                <EditText style="@style/Widget.MyLinks.Input" android:id="@+id/profileField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:inputType="textUri" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Profile image URL" android:textStyle="bold" android:textColor="@color/app_text" />
                <EditText style="@style/Widget.MyLinks.Input" android:id="@+id/profileImageField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Source"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/sourceField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Address (optional)"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/addressField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textPostalAddress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Google Maps URL"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/mapsField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openMapsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Google Maps link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="URL"
            android:textStyle="bold"
            android:textColor="@color/app_text" />

        <EditText
            style="@style/Widget.MyLinks.Input"
            android:id="@+id/urlField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />

        <Button
            android:id="@+id/deleteButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/app_error"
            android:text="Delete" />

    </LinearLayout>
</ScrollView>
